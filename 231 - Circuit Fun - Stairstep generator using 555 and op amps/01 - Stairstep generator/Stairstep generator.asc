TEXT -912 -336 Left 3 ;#231 Stairstep generator with 555 and dual op amp
TEXT -912 -280 Left 2 ;Source: Alan Wolke (W2AEW), https://www.youtube.com/watch?v=Kqb5zcrgv7s
TEXT -912 -240 Left 2 ;Short 555 pulses raise a held voltage in steps; a second oscillator resets the staircase.
TEXT -912 1024 Left 2 !.ic V(OUT)=0 V(CLOCK)=0
TEXT -912 1064 Left 2 !.tran 0 25m 0 1u
TEXT -200 1024 Left 2 !.meas tran RESET1 WHEN V(PULSE)=4.5 RISE=2
TEXT -200 1064 Left 2 !.meas tran RESET2 WHEN V(PULSE)=4.5 RISE=3
TEXT -200 1104 Left 2 !.meas tran RESET_PERIOD PARAM RESET2-RESET1
TEXT -200 1144 Left 2 !.meas tran OUT_PEAK MAX V(OUT) FROM 10m TO 20m
TEXT 560 1024 Left 2 !.meas tran CLK1 WHEN V(CLOCK)=4.5 RISE=20
TEXT 560 1064 Left 2 !.meas tran CLK2 WHEN V(CLOCK)=4.5 RISE=21
TEXT 560 1104 Left 2 !.meas tran CLK_PERIOD PARAM CLK2-CLK1
TEXT 560 1144 Left 2 !.meas tran STEPS PARAM (RESET2-RESET1)/(CLK2-CLK1)
TEXT -912 1216 Left 2 ;9 V is a simulation supply choice; Alan's notes give a broad operating range, not a single voltage.
TEXT -912 1256 Left 2 !.include "..\..\LTspice\Models\National Semiconductor\LMC6482A.lib"
