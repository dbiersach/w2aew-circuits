# LTspice records absolute paths in every .log it writes. The ltspicelog clean
# filter reduces those paths to bare filenames as a log is staged, so a local
# username and folder layout never reach the repository. Rerunning a
# simulation restores the full paths in the working copy, but the staged and
# committed form stays clean, and the file no longer shows as modified.
#
# Enable it once per clone, from the repository root:
#   git config filter.ltspicelog.clean "sh tools/strip-ltspice-log-paths.sh"
#
# Git silently ignores the attribute when that config is absent, and logs would
# then be staged with full paths, so set it before committing a log.
*.log filter=ltspicelog

# Keep the shell scripts LF so Git for Windows can run them.
*.sh text eol=lf

# GitHub's Linguist guesses a language from the file extension, and its guesses
# here are all wrong: .asc is its Adventure Game Studio script extension, .plt
# its SWI-Prolog test extension, and .cir a SPICE netlist this repository does
# not contain. Nothing here is source code in any language Linguist knows, so
# none of it should count towards the repository's language statistics.
#
# linguist-detectable only affects those statistics. It does not mark a file as
# vendored or generated, so diffs still render in full, which matters for a
# pull request that corrects a schematic.
*.asc linguist-detectable=false
*.plt linguist-detectable=false
*.cir linguist-detectable=false
*.asy linguist-detectable=false
*.lib linguist-detectable=false
*.sub linguist-detectable=false
*.net linguist-detectable=false
*.log linguist-detectable=false

# The two helper scripts are genuinely shell, but they are not what this
# repository is, and leaving them detectable would label the whole thing Shell.
*.sh linguist-detectable=false